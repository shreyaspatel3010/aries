<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aries_maintenance</name>
  <version>0.1.0</version>
  <description>ERC maintenance-panel task: locate the panel from its ArUco tags
  with rover and gripper cameras and operate all 26 of its controls with the arm.
  Marker geometry only -- no trained detector.</description>

  <maintainer email="shreyaspatel517@gmail.com">shreyas</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <!-- The panel model and its generated panel_task.json live in `aries`; this
       package never hard-codes a control position. -->
  <exec_depend>aries</exec_depend>
  <exec_depend>aries_moveit</exec_depend>
  <!-- Reused, not duplicated, exactly as aries_soil_sample does:
       NumpyImageBridge, because cv_bridge segfaults under NumPy 2.x. Nothing
       else is taken from the grasp pipeline: the panel task shares no
       perception, no detector and no grasp logic with it. -->
  <exec_depend>aries_vision_grasp</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>aries_common</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
