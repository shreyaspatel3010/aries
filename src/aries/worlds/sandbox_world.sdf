          <geometry>
            <box>
              <size>0.16 0.0615 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.760000 0.700000 0.500000 1</ambient>
            <diffuse>0.860000 0.780000 0.550000 1</diffuse>
            <specular>0.100000 0.100000 0.100000 1</specular>
