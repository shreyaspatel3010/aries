    <model name='probe'>
      <static>false</static>
      <link name='probe_link'>
        <pose>0 0 0.2 3.14159 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0002</iyy>
            <iyz>0</iyz>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name='probe_collision'>
          <max_contacts>500</max_contacts>
          <geometry>
            <mesh>
              <uri>package://aries/models/probe.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.5</mu>
                <mu2>2.5</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
            </bounce>
          </surface>
        </collision>
        <visual name='probe_visual'>
          <geometry>
            <mesh>
              <uri>package://aries/models/probe.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.000000 0.400000 0.000000 1</ambient>
            <diffuse>0.000000 0.800000 0.000000 1</diffuse>
            <specular>0.100000 0.100000 0.100000 1</specular>
          </material>
        </visual>
        <sensor name='probe_contact_sensor' type='contact'>
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>probe_collision</collision>
          </contact>
        </sensor>
       
        <enable_wind>false</enable_wind>
      </link>
      <!-- Planted in the sand box below instead of dropped from height: origin (bottom
           corner of probe.stl) rests on the socket floor, buried ~4.5 cm. A resting box
           balanced on just one corner is not a stable equilibrium, so an exact commanded
           tilt does not hold: it settles until it wedges against a socket wall. The small
           random lean seed below (roll ~1.6 deg, pitch ~3.9 deg, yaw ~339 deg) picks which
           side it leans toward; the tight 3.5 mm socket clearance mechanically bounds how
           far it can go. Verified in gz sim: settles in about 10 s and holds at roll ~3 deg,
           pitch ~9 deg (about 9.6 deg off vertical total) with under 1 cm of position drift,
           close enough to plumb for a vertical grasp to tolerate. -->
      <pose>0.40 0.0 0.016 0.0272 0.0678 5.9204</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='sand_box'>
      <static>true</static>
      <link name='sand_link'>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <!-- Sand block with a square socket left open around the probe's footprint
             (built from 4 wall slabs + a floor slab instead of one solid box) so the
             embedded lower ~4.5 cm of the probe doesn't interpenetrate solid collision
             geometry. Socket is 37x37 mm (3.5 mm clearance per side around the 30x30 mm
             probe cross-section), tight enough that the walls mechanically cap the
             settled tilt to a few degrees off vertical, see the probe model's pose comment. -->
        <collision name='sand_wall_north_collision'>
          <pose>0.415 0.06425 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.0615 0.06</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
            </bounce>
            <contact/>
          </surface>
        </collision>
