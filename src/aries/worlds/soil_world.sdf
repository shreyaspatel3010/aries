          <material>
            <ambient>0.45 0.36 0.24 1</ambient>
            <diffuse>0.45 0.36 0.24 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='tray_link_west_collision'>
          <pose>-0.08 0.0 0.0225 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.025</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
            <contact/>
          </surface>
        </collision>
        <visual name='tray_link_west_visual'>
          <pose>-0.08 0.0 0.0225 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.025</size></box></geometry>
          <material>
            <ambient>0.45 0.36 0.24 1</ambient>
            <diffuse>0.45 0.36 0.24 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>
    <!-- Soil: 36 loose 12 mm grains in the tray.
         Granular rather than one solid block on purpose: a scoop has to displace
         and carry individual grains, and grains are what visibly end up in the
         deposit box. Regenerate with a different GRID/PARTICLE size if you need
         finer material. Every grain is a dynamic body, so RTF pays for it. -->
    <model name='soil_grain_00'>
      <pose>0.3700 -0.1600 0.0170 0 0 0</pose>
      <link name='grain'>
        <inertial>
          <mass>0.003</mass>
          <inertia><ixx>7.200e-08</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>7.200e-08</iyy><iyz>0</iyz><izz>7.200e-08</izz></inertia>
        </inertial>
        <collision name='grain_collision'>
          <geometry><box><size>0.012 0.012 0.012</size></box></geometry>
          <surface>
            <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
            <contact/>
          </surface>
        </collision>
        <visual name='grain_visual'>
          <geometry><box><size>0.012 0.012 0.012</size></box></geometry>
          <material>
            <ambient>0.42 0.31 0.18 1</ambient>
            <diffuse>0.52 0.38 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>true</self_collide>
    </model>
