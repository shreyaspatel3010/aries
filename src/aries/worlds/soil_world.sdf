<sdf version='1.10'>
  <!-- Soil-sampling test world for aries_soil_sample.
       Derived from sandbox_world.sdf: same physics, plugins, lighting and ground
       plane, but the probe and its socketed sand block are GONE. In their place:
         * soil_tray   - a low-rimmed bed of loose grains to scoop from
         * soil_grain_NN - the granular material itself
         * deposit_box - an open box on the GROUND to tip the sample into
       Task this supports: scoop soil with the bucket fingertip, carry it, drop it
       in the box.

       The world is still named 'empty' ON PURPOSE. config/gazebo_bridge.yaml and
       rover_gazebo_bridge.yaml hardcode /world/empty/pose/info and
       /world/empty/light_config; renaming the world silently breaks both bridges.

       deposit_box sits on the ground rather than on the rover deck because a
       deck-mounted box is unreachable: measured on this arm, a tip-down release
       over the base-box column has no collision-free IK solution at ANY rim
       height, while a rim at or below ~0.22 m out in front does. Its 55 mm rim
       is well inside that.

       Generated; layout constants are documented in the generator. Launch with:
         ros2 launch aries my_robot.launch.py world:=soil_world.sdf
  -->
  <world name='empty'>
    <physics name='1ms' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin filename='gz-sim-imu-system' name='gz::sim::systems::Imu'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <!-- Soil bed: 150 mm square, 25 mm rim kept low so a ~30 deg bucket entry clears it -->
    <model name='soil_tray'>
      <static>true</static>
      <pose>0.42 -0.11 0 0 0 0</pose>
      <link name='tray_link'>
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia>
        </inertial>
        <collision name='tray_link_floor_collision'>
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.16999999999999998 0.16999999999999998 0.01</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
            <contact/>
          </surface>
        </collision>
        <visual name='tray_link_floor_visual'>
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.16999999999999998 0.16999999999999998 0.01</size></box></geometry>
          <material>
            <ambient>0.45 0.36 0.24 1</ambient>
            <diffuse>0.45 0.36 0.24 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='tray_link_north_collision'>
          <pose>0.0 0.08 0.0225 0 0 0</pose>
          <geometry><box><size>0.16999999999999998 0.01 0.025</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
