    <!-- Maintenance task panel, from the organisers' SolidWorks STEP
         ("Panel for Maintenance Tasks/Maintenance Task Panel .STEP") converted
         through OpenCASCADE and conditioned in Blender by
         scripts/build_erc2026_props.py. 0.49 x 0.39 x 1.00 m, base on the
         ground, console face 33 deg off vertical, model front is its own +X.

         Collision is a 2 322-face decimation of the 116 172-face visual: DART
         only needs the sloped-box silhouette, and the real mesh would put every
         switch and socket into the broad phase.

         The drawing shows three 50 x 50 mm ArUco locations: top-left,
         top-right and bottom-left, with 260 mm horizontal and 380 mm vertical
         centre spacing. This deterministic practice setup uses ORIGINAL-
         library ids 11/13/14 in those slots. ID 15 is another organiser-
         permitted replacement, not an unsupported fourth simultaneous tag.

         The update report gives the panel's geometry and the task start S8 but
         does not publish a surveyed panel pose. For practice it is placed
         exactly 2.5 m from S8 toward the yard centre, with its face aimed at
         S8; this is the only non-surveyed placement in the rover yard. -->
    <include>
      <uri>model://maintenance_panel</uri>
      <name>maintenance_panel</name>
      <pose>0.7443 1.5540 0.3 0 -1.57 1.57</pose>
    </include>

    <light name='sun' type='directional'>
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <!-- ~48 deg elevation: high enough to light the yard floor between the
           rock lines, low enough that the ridges still cast the shadows a
           vision pipeline has to cope with. -->
      <direction>-0.42 0.5 -0.757</direction>
      <diffuse>0.95 0.92 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
