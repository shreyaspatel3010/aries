<sdf version='1.10'>
  <!-- ERC 2026 MarsYard, built from the official survey package
       (2026_MarsYard_3D.zip: photogrammetry mesh + georeferenced orthophoto +
       Coordinates_MarsYard2026.txt).

       Regenerate the terrain images, the ArUco landmark boards and the marker
       models with scripts/build_marsyard2026_terrain.py, pointing its 'source'
       option at the extracted 2026_MarsYard_3D_Model directory. That script
       prints the size and pose numbers used below, so if you re-run it at a
       different resolution, copy its output back into here.

       The world is deliberately named 'leo_marsyard', the same as
       marsyard.sdf, so config/marsyard_gazebo_bridge.yaml and its
       /world/leo_marsyard/* topics work against either yard unchanged. The two
       worlds are never loaded together. -->
  <world name='leo_marsyard'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <dart>
        <!-- DART's own bullet collision detector maps the heightmap onto
             btHeightfieldTerrainShape, which is what makes a 1025x1025 grid
             affordable to drive on. Its default (FCL) is markedly slower here. -->
        <collision_detector>bullet</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <sky/>
      <shadows>true</shadows>
    </scene>

    <!-- Terrain.
         Geometry is a heightmap rather than the 1.68 M-triangle survey mesh:
         contact against a regular grid is a cell lookup instead of a broad-phase
         pass over the whole mesh, and mesh-vs-mesh is where DART is least
         robust under the wheels. The cost is that overhangs cannot be
         represented, which for rocks lying on graded sand costs nothing a rover
         could drive under.

         Heights are on the yard's LEVELED survey datum, not the mesh's own.
         The photogrammetry vertical is tilted ~1.34 deg along Y and ~0.62 deg
         along X relative to the surveyed H column - left uncorrected the far
         end of the yard sits over half a metre below its real height. After the
         fit the DEM matches the official coordinates to 0.020 m std at the nine
         starting locations and 0.021 m at the nine traverse waypoints.

         44 x 44 m patch at 1025 px = 4.30 cm/px, centred on the survey mesh, so
         the model pose below carries that centre and world (0, 0) stays the
         survey origin S1.

         The pose Z is the DEM's minimum, -0.822577, and <pos> is left at zero
         on purpose. gz-sim IGNORES a heightmap's <pos> Z: it puts pixel value 0
         at the link origin and scales to <size> Z from there, so the vertical
         datum has to ride on the model pose. That was measured on this stack,
         not assumed - 34 probes on prismatic joints dropped onto the terrain at
         the surveyed X/Y reproduced the DEM to 5.3 mm, and moving <pos> Z
         changed nothing while moving the model pose Z shifted the terrain
         one-for-one. Put the offset back in <pos> and the whole yard sits 0.8 m
         low with no warning from gz. -->
    <model name='marsyard2026_terrain'>
      <static>true</static>
      <pose>0.190492 14.019499 -0.822577 0 0 0</pose>
      <link name='marsyard_terrain'>
        <collision name='terrain_collision'>
          <geometry>
            <heightmap>
              <uri>dem/marsyard2026_terrain_hm.png</uri>
              <pos>0 0 0</pos>
              <size>44 44 2.254232</size>
            </heightmap>
          </geometry>
          <surface>
            <!-- Compacted sandy regolith / Mars-yard soil, matching the ground
                 planes in the other aries worlds so a drive tuned in one
                 transfers. mu = tan(phi) for phi ~ 37 deg, the internal
                 friction angle of a compacted sand-gravel simulant under a
                 lugged wheel. Isotropic on purpose - soil has no preferred
                 direction, so tread anisotropy belongs on the wheel.

                 dartsim reads only mu / mu2 / fdir1 / slip1 / slip2 from <ode>
                 plus restitution_coefficient. kp, kd, min_depth and max_vel are
                 soft-contact terms it ignores; torsional and rolling friction
                 it rejects outright. Surfaces combine with min(), so this is
                 the traction ceiling for anything driving on the yard. -->
            <friction>
              <ode>
                <mu>0.75</mu>
                <mu2>0.75</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
            </bounce>
            <contact/>
          </surface>
        </collision>
        <visual name='terrain_visual'>
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <!-- Deliberately a DIFFERENT heightmap from the collision above:
                   the same 257-cell downsample of it. gz-sim's Ogre terrain
                   renders a dense field of sharp cones from the full 1025 grid,
                   still visible at 513 and gone at 257. It is not the bit depth
                   (8-bit behaves identically) and not <sampling> (1 changes
                   nothing) - all three were tried against a camera in-sim.
                   Physics therefore keeps the full-resolution grid and the
                   cameras get a surface that is smoothed rather than spiked.
                   The two agree in the mean: same extent, same size, area
                   averaged, so nothing shifts vertically. -->
              <!-- This <pos> carries the FULL terrain placement, unlike the
                   collision above which takes it from the model pose. gz-sim
                   places a heightmap VISUAL from <pos> alone and ignores the
                   model pose, while the COLLISION does the opposite. With
                   <pos>0 0 0</pos> here the rendered yard sat 14 m from the
                   collision it is supposed to skin, so every marker looked
                   like it was floating off the edge of the map while its
                   physics was perfectly fine. Measured: a top-down camera at
                   the patch centre put the terrain's image-space centre at
                   (596, 600) against a frame centre of (600, 600) once these
                   numbers matched the model pose. Keep the two in step. -->
              <uri>dem/marsyard2026_terrain_hm_visual.png</uri>
              <pos>0.190492 14.019499 -0.822577</pos>
              <size>44 44 2.254232</size>
              <texture>
                <!-- The orthophoto, resampled onto exactly the patch above, so
                     colour and height are aligned pixel for pixel. <size> is
                     the world span the texture covers; at 44 it maps once
                     across the terrain instead of tiling. -->
                <diffuse>dem/marsyard2026_terrain_texture.png</diffuse>
                <normal>dem/flat_normal.png</normal>
                <size>44</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Official survey points, visual only.
         These are navigation references, not obstacles: the physical markers
         that stood in the yard during the scan are already baked into the
         terrain heights, so giving these posts collision would add geometry the
         rover can hit that is not there on the day. Poses are the surveyed X/Y
         and the surveyed H, which is why the terrain had to be leveled onto the
         same datum - otherwise every marker floats or buries. -->
    <!-- 34 official survey points from Coordinates_MarsYard2026.txt.
         L1-L15 are ArUco landmark boards (5x5 library, ids 51-65, landmark n -> id 50+n) and are collidable.
         S (green) starts, W (blue) traverse waypoints and P (red) deep
         sampling square are visual only - they are ground marks, not objects. -->
    <model name='marker_S1'>
      <static>true</static>
      <pose>0.000 0.000 0.026 0 0 0</pose>
      <link name='link'>
        <visual name='post'>
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.030</radius><length>0.450</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.75 0.20 1</ambient><diffuse>0.15 0.75 0.20 1</diffuse>
            <emissive>0.15 0.75 0.20 0.35</emissive>
          </material>
        </visual>
        <visual name='cap'>
          <pose>0 0 0.450 0 0 0</pose>
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material>
            <ambient>0.15 0.75 0.20 1</ambient><diffuse>0.15 0.75 0.20 1</diffuse>
            <emissive>0.15 0.75 0.20 0.55</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name='marker_S2'>
