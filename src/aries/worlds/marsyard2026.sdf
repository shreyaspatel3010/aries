<sdf version='1.10'>
  <!-- ERC 2026 MarsYard, built from the official survey package
       (2026_MarsYard_3D.zip: photogrammetry mesh + georeferenced orthophoto +
       Coordinates_MarsYard2026.txt).

       Regenerate the terrain images, ArUco landmark boards and survey frames
       with scripts/build_marsyard2026_terrain.py, pointing its 'source'
       option at the extracted 2026_MarsYard_3D_Model directory. That script
       prints the size and pose numbers used below, so if you re-run it at a
       different resolution, copy its output back into here.

       The world is deliberately named 'empty'. my_robot.launch.py uses
       config/gazebo_bridge.yaml, whose world-scoped pose and light topics are
       /world/empty/*. Keeping the same name as the other selectable worlds is
       required for odometry, TF consumers and GUI controls to keep working. -->
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <dart>
        <!-- Bullet maps the heightmap onto btHeightfieldTerrainShape. Together
             with primitive wheel collision cylinders this gives stable,
             deterministic rover contact on the surveyed surface. -->
        <collision_detector>bullet</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <!-- The default editor grid draws a large square lattice through the
           coloured yard. It is a GUI aid, not part of the ERC environment. -->
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <sky/>
      <shadows>true</shadows>
    </scene>

    <!-- Terrain.
         Visual and collision deliberately use the SAME 257 x 257 heightmap.
         A triangle-mesh collision works for primitive probes but DART lets the
         rover's detailed wheel collision meshes pass through it. Sharing one
         heightfield gives the wheels a stable contact primitive and guarantees
         that the rendered and physical surfaces have identical samples. The
         official orthophoto is mapped over that surface for colour.

         Heights are on the yard's LEVELED survey datum, not the mesh's own.
         The photogrammetry vertical is tilted ~1.34 deg along Y and ~0.62 deg
         along X relative to the surveyed H column - left uncorrected the far
         end of the yard sits over half a metre below its real height. After the
         fit the DEM matches the official coordinates to 0.020 m std at the nine
         starting locations and 0.021 m at the nine traverse waypoints.

         The 44 x 44 m patch is centred on the survey mesh and the model pose
         carries its minimum height, so world (0, 0) remains survey origin S1. -->
    <model name='marsyard2026_terrain'>
      <static>true</static>
      <pose>0.190492 14.019499 -0.822577 0 0 0</pose>
      <link name='marsyard_terrain'>
        <collision name='terrain_collision'>
          <geometry>
            <heightmap>
              <uri>dem/marsyard2026_terrain_hm_visual.png</uri>
              <pos>0 0 0</pos>
              <size>44 44 2.254232</size>
            </heightmap>
          </geometry>
          <surface>
            <!-- Compacted Mars-yard soil mixed with sand. This is an effective
                 rigid-contact shear ceiling, not tan(internal friction angle):
                 soil internal friction and wheel drawbar traction are different
                 quantities. The ground is isotropic; tread anisotropy and slip
                 are specified on the six wheel collisions.

                 dartsim reads only mu / mu2 / fdir1 / slip1 / slip2 from <ode>
                 plus restitution_coefficient. kp, kd, min_depth and max_vel are
                 soft-contact terms it ignores; torsional and rolling friction
                 it rejects outright. Surfaces combine with min(), so this is
                 the traction ceiling for anything driving on the yard. A
                 value of 0.65 represents the compacted yard ground mixed with
                 sand described by the ERC report; deformable-soil losses are
                 represented by force-dependent slip on the rover tires. -->
            <friction>
              <ode>
                <mu>0.65</mu>
                <mu2>0.65</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
            </bounce>
            <contact/>
          </surface>
        </collision>
        <visual name='terrain_visual'>
          <geometry>
            <heightmap>
              <!-- gz-sim places a heightmap visual from <pos> instead of the
                   parent model pose, while collision uses the model pose. -->
              <uri>dem/marsyard2026_terrain_hm_visual.png</uri>
              <pos>0.190492 14.019499 -0.822577</pos>
              <size>44 44 2.254232</size>
              <texture>
                <diffuse>dem/marsyard2026_terrain_texture.png</diffuse>
                <normal>dem/flat_normal.png</normal>
                <size>44</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Official survey points. Landmarks are physical ArUco boards. Starts,
         waypoints and P1 are named coordinate frames only; the organiser
         report does not show coloured posts or a painted red sampling pad. -->
    <!-- 34 official survey points from Coordinates_MarsYard2026.txt.
         L1-L15 are ArUco landmark boards (5x5 library, ids 51-65, landmark n -> id 50+n) and are collidable.
         S starts, W traverse waypoints and P deep-sampling location are
         named frames only: the report defines coordinates, not visible props. -->
    <frame name='S1'>
      <pose>0.000 0.000 0.000 0 0 0</pose>
    </frame>
    <frame name='S2'>
      <pose>0.000 26.427 0.138 0 0 0</pose>
    </frame>
    <frame name='S3'>
      <pose>10.709 6.918 0.067 0 0 0</pose>
    </frame>
    <frame name='S4'>
      <pose>11.210 17.881 0.100 0 0 0</pose>
    </frame>
    <frame name='S5'>
      <pose>13.223 25.658 -0.035 0 0 0</pose>
    </frame>
    <frame name='S6'>
      <pose>-9.428 15.824 -0.302 0 0 0</pose>
    </frame>
    <frame name='S7'>
      <pose>-8.970 22.831 -0.180 0 0 0</pose>
    </frame>
    <frame name='S8'>
      <pose>-15.676 4.991 -0.280 0 0 0</pose>
    </frame>
    <frame name='S9'>
      <pose>7.160 -4.762 -0.095 0 0 0</pose>
    </frame>
    <model name='landmark_L1'>
      <static>true</static>
      <pose>3.183 8.012 0.414 0 0 -3.5198</pose>
      <link name='link'>
        <collision name='post_collision'>
          <pose>0 0 0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.250</length></cylinder></geometry>
        </collision>
        <visual name='post_visual'>
          <pose>0 0 0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.250</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <collision name='board_collision'>
          <pose>0 0 0.525 0 0 0</pose>
          <geometry><box><size>0.400 0.02 0.550</size></box></geometry>
        </collision>
        <visual name='board_visual'>
          <pose>0 0 0.525 0 0 0</pose>
          <geometry><box><size>0.400 0.02 0.550</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://marsyard2026/landmark_L1.png</albedo_map>
              <roughness>0.9</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
