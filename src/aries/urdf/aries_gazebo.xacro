  </gazebo>

  

  <!-- Gazebo Plugin for Pose Publisher -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>60</static_update_frequency>
    </plugin>
  </gazebo>

  <!-- Ground-truth odometry drives the simulation EKF and corrected TF. -->
  <gazebo>
        <plugin filename="libgz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>/ground_truth/odom</odom_topic>
            <dimensions>2</dimensions>
            <odom_publish_frequency>60</odom_publish_frequency>
        </plugin>
  </gazebo>
    
  <gazebo reference="imu_frame">
      <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>60</update_rate>
          <gz_frame_id>imu_frame</gz_frame_id>
          <visualize>true</visualize>
          <topic>/imu</topic>
      </sensor>
  </gazebo>


  <!-- Gazebo Plugin for Diff Drive -->
  <gazebo>
      <plugin 
          filename="gz-sim-diff-drive-system" 
          name="gz::sim::systems::DiffDrive">
          <left_joint>L_1_Wheel_Joint</left_joint>
          <left_joint>L_2_Wheel_Joint</left_joint>
          <left_joint>L_3_Wheel_Joint</left_joint>
          <right_joint>R_1_Wheel_Joint</right_joint>
          <right_joint>R_2_Wheel_Joint</right_joint>
          <right_joint>R_3_Wheel_Joint</right_joint>
          <wheel_separation>0.759</wheel_separation>
          <wheel_radius>0.1100</wheel_radius>
          <frame_id>odom</frame_id>
          <topic>/cmd_vel</topic>
          <odom_topic>/odom</odom_topic>
          <!-- Keep wheel-integrated TF private to Gazebo. The simulation EKF
               is the single ROS owner of odom -> base_footprint. -->
          <tf_topic>/wheel_odom/tf</tf_topic>
          <child_frame_id>base_footprint</child_frame_id>
          <odom_publish_frequency>60</odom_publish_frequency>
      </plugin>
  </gazebo>

  





    

    

    

  <xacro:if value="${enable_full_robot_gazebo_extras}">
    <!-- High-friction gripper pads so the probe does not slip during lift. -->
    <gazebo reference="arm_gripper_left_link">
      <mu1>6.0</mu1>
      <mu2>6.0</mu2>
      <kp>1000000</kp>
      <kd>10</kd>
    </gazebo>
    <gazebo reference="arm_gripper_right_link">
      <mu1>6.0</mu1>
      <mu2>6.0</mu2>
      <kp>1000000</kp>
      <kd>10</kd>
    </gazebo>
  </xacro:if>

</robot>
