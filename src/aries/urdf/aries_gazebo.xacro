      </plugin> -->

      <!-- Gripper controllers disabled - ros2_control handles these via MoveIt -->
      <!-- <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
        <joint_name>gripper_gear_left_joint</joint_name>
