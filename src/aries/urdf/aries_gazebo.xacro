<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- Gazebo Materials -->
  <gazebo reference="base_link">
 
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="drill_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="drill_motor_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="drill_container_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="C_Differential_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="L_Connecting_Rod_Diff_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="R_Connecting_Rod_Diff_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  
  <gazebo reference="L_Rocker_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  
  <gazebo reference="R_Rocker_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  
  <gazebo reference="L_Boggie_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  
  <gazebo reference="R_Boggie_Link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  
  <gazebo reference="L_1_Wheel_Link">
    <!-- The cylinder-local Z axis is the wheel axle, so fdir1 and mu1 are
         lateral. mu2 is longitudinal, capped to 0.65 by the yard surface.
         WheelSlip below adds speed-dependent granular-soil compliance. -->
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  
  <gazebo reference="L_2_Wheel_Link">
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  
  <gazebo reference="L_3_Wheel_Link">
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  
  <gazebo reference="R_1_Wheel_Link">
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  
  <gazebo reference="R_2_Wheel_Link">
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  
  <gazebo reference="R_3_Wheel_Link">
    <mu1>0.42</mu1>
    <mu2>0.85</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <!-- Gazebo's supported deformable-terrain approximation. The 90 kg rover
       has an average static wheel load of 90 * 9.8 / 6 = 147 N. Compliance
       gives about 13% longitudinal and 15% lateral slip at the respective
       friction limits instead of the perfect no-slip behaviour of Coulomb
       contact alone. -->
  <gazebo>
    <plugin filename="gz-sim-wheel-slip-system"
            name="gz::sim::systems::WheelSlip">
      <xacro:macro name="marsyard_wheel_slip" params="link_name">
        <wheel link_name="${link_name}">
          <slip_compliance_lateral>0.35</slip_compliance_lateral>
          <slip_compliance_longitudinal>0.20</slip_compliance_longitudinal>
          <wheel_normal_force>147.0</wheel_normal_force>
          <wheel_radius>${wheel_radius}</wheel_radius>
        </wheel>
      </xacro:macro>
      <xacro:marsyard_wheel_slip link_name="L_1_Wheel_Link"/>
      <xacro:marsyard_wheel_slip link_name="L_2_Wheel_Link"/>
      <xacro:marsyard_wheel_slip link_name="L_3_Wheel_Link"/>
      <xacro:marsyard_wheel_slip link_name="R_1_Wheel_Link"/>
      <xacro:marsyard_wheel_slip link_name="R_2_Wheel_Link"/>
      <xacro:marsyard_wheel_slip link_name="R_3_Wheel_Link"/>
    </plugin>
  </gazebo>
  
  <!-- Gazebo Plugin for Joint State Publisher -->
  <!-- Only publish rover wheel joints here -->
  <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>L_Rocker_Joint</joint_name>
            <joint_name>R_Rocker_Joint</joint_name>
            <joint_name>L_Boggie_Joint</joint_name>
            <joint_name>R_Boggie_Joint</joint_name>
            <joint_name>L_1_Wheel_Joint</joint_name>
            <joint_name>L_2_Wheel_Joint</joint_name>
            <joint_name>L_3_Wheel_Joint</joint_name>
            <joint_name>R_1_Wheel_Joint</joint_name>
            <joint_name>R_2_Wheel_Joint</joint_name>
            <joint_name>R_3_Wheel_Joint</joint_name>
            <joint_name>aux_L_Rocker_joint</joint_name>
            <joint_name>aux_R_Rocker_joint</joint_name>
            <!-- The drill's three axes. Not on ros2_control: they are driven
                 by the JointController plugins below, so their state has to
                 come from here or robot_state_publisher never moves the
                 meshes. It is also what the teleop's limit switches read. -->
            <joint_name>drill_motor_joint</joint_name>
            <joint_name>drill_container_joint</joint_name>
            <joint_name>drill_bit_joint</joint_name>
        </plugin>
  </gazebo>

  <gazebo>
   
    <plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
      <joint_name>L_Rocker_Joint</joint_name>
      <topic>/model/aries/joint/L_Rocker_Joint/cmd_pos</topic>
      <p_gain>1000</p_gain><i_gain>2</i_gain><d_gain>300</d_gain>
      <kp>10</kp><ki>0.1</ki><kd>0.3</kd>
      <i_min>-6</i_min><i_max>6</i_max>
    </plugin>

    
    <plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
      <joint_name>R_Rocker_Joint</joint_name>
      <topic>/model/aries/joint/R_Rocker_Joint/cmd_pos</topic>
      <p_gain>1000</p_gain><i_gain>2</i_gain><d_gain>300</d_gain>
      <kp>10</kp><ki>0.1</ki><kd>0.3</kd>
      <i_min>-6</i_min><i_max>6</i_max>
    </plugin>

    <!-- Drill feed and sample container. Both are RATE-commanded, in m/s, and
         both exist as much to HOLD as to drive.

         Neither axis is a position servo on the real drill. The feed carriage
         is a DC motor turning a lead screw and the bin is a prismatic linear
         actuator: you run the motor, you stop the motor, and the mechanism
         stays exactly where you stopped it, because neither a lead screw nor
         an actuator of that kind is backdrivable. JointController with
         use_force_commands OFF is that mechanism - it hands the joint a
         velocity command, which dartsim services as a servo, so a commanded
         0 pins the axis rather than letting a 4.1 kg carriage sink.

         These WERE JointPositionControllers, and the reason they are not any
         more is worth keeping: a position PID holds by force, so it sagged
         mg/p_gain = 4.1 x 9.81 / 800 = 50 mm below its target the moment
         physics started, and the teleop, which re-seeded its target from the
         measured pose on every LT press, then walked the carriage 50 mm
         further down its stroke per press. Raising the gain only makes the
         sag smaller; the axis still has a target it can be told wrong. A rate
         command has no target at all.

         Travel is bounded by the limit switches modelled in
         aries_teleop/drill_joystick.py, which stop the motor just inside the
         URDF stops. Behind them dartsim enforces the joint limit itself even
         under a velocity command - a rig of this joint, 4.1 kg on the same
         limits, run at -0.05 m/s stopped dead at -0.375000 and held there
         with 0.0000 mm of drift once commanded zero, and idled at -9 um after
         180 s of sim time with no command at all. So a raw publish here
         cannot drive the carriage through the mast; it can still run the bin
         into the auger, which is a geometry limit and not a stop. -->
    <plugin filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">
      <joint_name>drill_motor_joint</joint_name>
      <topic>/model/aries/joint/drill_motor_joint/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">
      <joint_name>drill_container_joint</joint_name>
      <topic>/model/aries/joint/drill_container_joint/cmd_vel</topic>
    </plugin>

    <!-- The auger: rad/s, a positive value one way and a negative value the
         other, indefinitely. Holding a spindle at an angle, which is what a
         position controller would do, is not a thing a drill does, and it
         needs no holding controller either - the axis is vertical and the
         bit's COM sits on it to within 46 um, so gravity applies no torque
         about it.

         Unlike the two feed axes this one keeps use_force_commands ON. It is
         the axis that meets the ground, and a force-side velocity PID lets it
         load up and stall against soil the way the motor does; the feed axes
         are servo-pinned instead because a lead screw does not yield. -->
    <plugin filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">
      <joint_name>drill_bit_joint</joint_name>
      <topic>/model/aries/joint/drill_bit_joint/cmd_vel</topic>
      <use_force_commands>true</use_force_commands>
      <p_gain>2.0</p_gain><i_gain>0.2</i_gain>
    </plugin>

     
