<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Materials -->
  <material name="silver">
    <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
  </material>
  <material name="blue">
    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
  </material>
  <material name="gray">
    <color rgba="0.647058823529412 0.619607843137255 0.588235294117647 1"/>
  </material>
  <!-- Properties -->
  <xacro:property name="PI" value="3.1415926535897931"/>
  <!-- Mass recovered from the exported wheel inertia tensor. For a wheel with
       r = 0.110 m, I_axis = 0.0160988 kg m^2 = 1/2 m r^2 gives
       m = 2.661 kg. The previous 50 kg placeholder made the six wheels alone
       weigh 300 kg and produced non-physical normal/friction forces. -->
  <xacro:property name="wheel_mass" value="2.661"/>
  <xacro:property name="wheel_radius" value="0.1100"/>
  <xacro:property name="wheel_thickness" value="0.070"/>
  <!-- Height of base_link above the wheel contact plane.
       base_footprint is by convention the ground projection of the base, so
       this must place the bottom of the wheels at exactly z = 0. It was
       hard-coded to 0.165, which left the wheels 41 mm BELOW base_footprint —
       everything treating that frame as ground (EKF, odom->base_footprint,
       nav ground filtering) inherited that error.
       Forward kinematics through the rocker/bogie chain puts the front and
       middle wheel centres 0.0964 m below base_link, so the base must stand
       one wheel radius above that. Derived rather than hard-coded so the two
       can no longer drift apart if wheel_radius changes. -->
  <xacro:property name="wheel_centre_below_base_link" value="0.0964"/>
  <xacro:property name="base_link_height" value="${wheel_radius + wheel_centre_below_base_link}"/>
  <!-- Mesh locations -->
  <xacro:property name="mesh_location" value="package://aries/meshes"/>
  <!-- Enable Mimic joints -->
  <xacro:property name="enable_mimic" value="true"/>
  <!-- Enable D435i -->
  <xacro:property name="enable_D435i" value="true"/>
  <!-- Enable Gazebo extras used by the full robot description -->
  <xacro:property name="enable_full_robot_gazebo_extras" value="true"/>
</robot>
