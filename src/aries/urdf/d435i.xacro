<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="realsense_d435i">

    <!-- D435i Camera Physical Dimensions -->
    <xacro:property name="M_PI" value="3.1415926535897931"/>
    <xacro:property name="d435i_cam_width" value="0.090"/>
    <xacro:property name="d435i_cam_height" value="0.025"/>
    <xacro:property name="d435i_cam_depth" value="0.02505"/>
    <xacro:property name="d435i_cam_mount_from_center_offset" value="0.0149"/>
    
    <!-- Camera Sensor Offsets -->
    <xacro:property name="d435i_cam_depth_to_left_ir_offset" value="0.0"/>
    <xacro:property name="d435i_cam_depth_to_right_ir_offset" value="-0.050"/>
    <xacro:property name="d435i_cam_depth_to_color_offset" value="0.015"/>
    
    <!-- Mount Position Offsets -->
    <xacro:property name="d435i_cam_depth_py" value="0.0175"/>
    <xacro:property name="d435i_cam_depth_pz" value="0.0125"/>

    <!-- Material definitions -->
    <material name="camera_aluminum">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- Camera body, with origin at bottom screw mount -->
    <joint name="rover_camera_joint" type="fixed">
        <origin xyz="0.2608 0.000023 0.2535" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rover_camera_bottom_screw_frame"/>
    </joint>
    <link name="rover_camera_bottom_screw_frame"/>

    <joint name="rover_camera_link_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="rover_camera_bottom_screw_frame"/>
        <child link="rover_camera_link"/>
    </joint>

    <link name="rover_camera_link">
        <visual>
            
            <geometry>
                <mesh filename="${mesh_location}/d435.stl"/>
            </geometry>
            <material name="camera_aluminum"/>
        </visual>
        <collision>
            <origin xyz="-0.0126 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.0252 0.090 0.025"/>
            </geometry>
        </collision>
        <!-- Uniform box of the collision dimensions (25.2 x 90 x 25 mm) at the
             datasheet mass of the D435i. The previous 0.564 kg / 1e-3-scaled
             tensor was neither the real camera nor consistent with the
             identical gripper camera; both now derive from m/12*(a^2+b^2).
             The COM sits at the collision box centroid, not at the link origin
             (which is the bottom screw mount, on the front face). -->
        <inertial>
            <mass value="0.072"/>
            <origin xyz="-0.0126 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00005235" ixy="0.0" ixz="0.0"
                     iyy="0.00000751" iyz="0.0" izz="0.00005236"/>
        </inertial>
    </link>

    <!-- Camera depth sensor frames -->
    <joint name="rover_camera_depth_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="rover_camera_link"/>
        <child link="rover_camera_depth_frame"/>
    </joint>
    <link name="rover_camera_depth_frame"/>
    
    <joint name="rover_camera_depth_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
        <parent link="rover_camera_depth_frame"/>
        <child link="rover_camera_depth_optical_frame"/>
    </joint>
    <link name="rover_camera_depth_optical_frame"/>

    <!-- Camera IR sensor frames -->
    <joint name="rover_camera_left_ir_joint" type="fixed">
        <origin xyz="0 0.0 0" rpy="0 0 0"/>
        <parent link="rover_camera_depth_frame"/>
        <child link="rover_camera_left_ir_frame"/>
    </joint>
    <link name="rover_camera_left_ir_frame"/>
    
    <joint name="rover_camera_left_ir_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
        <parent link="rover_camera_left_ir_frame"/>
        <child link="rover_camera_left_ir_optical_frame"/>
    </joint>
    <link name="rover_camera_left_ir_optical_frame"/>
    
    <joint name="rover_camera_right_ir_joint" type="fixed">
        <origin xyz="0 -0.050 0" rpy="0 0 0"/>
        <parent link="rover_camera_depth_frame"/>
        <child link="rover_camera_right_ir_frame"/>
    </joint>
    <link name="rover_camera_right_ir_frame"/>
    
    <joint name="rover_camera_right_ir_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
        <parent link="rover_camera_right_ir_frame"/>
        <child link="rover_camera_right_ir_optical_frame"/>
    </joint>
    <link name="rover_camera_right_ir_optical_frame"/>

    <!-- Camera color sensor frames -->
    <joint name="rover_camera_color_joint" type="fixed">
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <parent link="rover_camera_depth_frame"/>
        <child link="rover_camera_color_frame"/>
    </joint>
    <link name="rover_camera_color_frame"/>
    
    <joint name="rover_camera_color_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
        <parent link="rover_camera_color_frame"/>
        <child link="rover_camera_color_optical_frame"/>
    </joint>
    <link name="rover_camera_color_optical_frame"/>

    <!-- The accel/gyro frames were removed with the IMU sensor: the D435i IMU is
         not used anywhere in the stack, and the hardware driver is launched with
         enable_gyro/enable_accel false, so it publishes no IMU frames either. -->

    <!-- Gazebo configuration for Ionic/ROS2 Jazzy -->
    <xacro:if value="${enable_D435i}">
        <gazebo reference="rover_camera_link">
            <self_collide>0</self_collide>
            <enable_wind>0</enable_wind>
            <kinematic>0</kinematic>
            <mu2>1</mu2>
            <fdir1>0 0 0</fdir1>
            <kp>1e+13</kp>
            <kd>1</kd>
            
            <!-- Color Camera Sensor - 15 Hz: nothing on the rover consumes this
                 stream faster, and every render sensor competes for GPU time with
                 the gripper camera used for grasping.

                 FOV/resolution are deliberately IDENTICAL to the depth sensor
                 below. The RViz DepthCloud display (urdf_config.rviz) paints this
                 image onto the depth image pixel-for-pixel, which is only valid
                 when both share intrinsics; the depth sensor used to be 1.487 rad
                 against this 1.211 rad, which mis-coloured the cloud by ~23 cm at
                 the image edge at 1 m.

                 gz_frame_id is depth_optical_frame, not color_optical_frame:
                 Gazebo renders both sensors from rover_camera_link, so declaring the
                 color frame would apply a 15 mm offset that does not exist in
                 simulation. Same reasoning as gripper_camera.xacro. -->
            <sensor name="rover_camera_color" type="camera">
                <camera name="rover_camera">
                    <horizontal_fov>1.211</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>RGB_INT8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>rover_camera/color/image_raw</topic>
                <gz_frame_id>rover_camera_depth_optical_frame</gz_frame_id>
            </sensor>

            <!-- The infra1/infra2 render sensors were removed from simulation:
                 nothing subscribes to them and each render sensor costs
                 significant GPU time. The IR frames/links are kept for TF parity
                 with the hardware driver. -->

            <!-- Depth Camera Sensor - 15 Hz, same intrinsics as the color sensor
                 (see color-sensor comment for why they must match). -->
            <sensor name="rover_camera_depth" type="depth_camera">
                <camera name="rover_camera">
                    <horizontal_fov>1.211</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                    <!-- 3 mm, the D435i datasheet figure and what the gripper
                         camera uses. The old 0.100 m put +/-10 cm of noise on
                         every pixel, which swamped the measurement entirely. -->
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.003</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>rover_camera/depth/image_rect_raw</topic>
                <gz_frame_id>rover_camera_depth_optical_frame</gz_frame_id>
            </sensor>

            <!-- The IMU sensor was removed: nothing subscribes to it, it was
                 bridged to ROS in no configuration, and the camera IMU is unused
                 stack-wide (the rover has its own IMU). -->
        </gazebo>
    </xacro:if>
</robot>
