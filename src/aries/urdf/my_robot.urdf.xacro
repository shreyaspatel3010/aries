<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aries">
  <!-- THE ST3215 RACK-AND-PINION IS THE ONLY GRIPPER as of 2026-08-30.

       gripper_v2 (the REBEL-6DOF-04 four-bar, servo driven through the Teensy)
       is retired to urdf/legacy/ and its meshes to meshes/unused/gripper_v2/,
       alongside the older 'new' and 'old' grippers. Nothing in the fleet runs
       them.

       gripper_type is still DECLARED because a dozen launch files pass it down
       and an undeclared arg is a hard error, but 'st3215' is the only accepted
       value and every launch file's choices= is narrowed to it. finger_type is
       likewise accepted and ignored: it selected between v2's three swappable
       fingertips, and this gripper has one CAD'd pair of scoops with no
       fingertip interface. -->
  <xacro:arg name="gripper_type" default="st3215"/>
  <xacro:property name="gripper_type" value="$(arg gripper_type)"/>
  <!-- Swappable fingertip - 'bucket', 'maintenance', or 'probe' -->
  <xacro:arg name="finger_type" default="probe"/>
  <xacro:property name="finger_type" value="$(arg finger_type)"/>
  <!-- Hardware protocol - 'mock_hardware', 'gazebo', or 'rebel' -->
  <xacro:arg name="hardware_protocol" default="gazebo"/>
  <xacro:property name="hardware_protocol" value="$(arg hardware_protocol)"/>
  <!-- Allow arm and gripper hardware backends to diverge for special launch cases -->
  <xacro:arg name="arm_hardware_protocol" default="$(arg hardware_protocol)"/>
  <xacro:property name="arm_hardware_protocol" value="$(arg arm_hardware_protocol)"/>
  <xacro:arg name="gripper_hardware_protocol" default="$(arg hardware_protocol)"/>
  <xacro:property name="gripper_hardware_protocol" value="$(arg gripper_hardware_protocol)"/>
  <!-- Teensy gripper serial port (only used when hardware_protocol=rebel) -->
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:property name="serial_port" value="$(arg serial_port)"/>
  <!-- ST3215 bus-servo adapter, used only by gripper_type:=st3215. The
       defaults mirror aries_common/config/devices.yaml's servo_bus block; the
       launch files pass the resolved values in rather than relying on them. -->
  <xacro:arg name="servo_bus_port" default="/dev/aries_servo_bus"/>
  <xacro:property name="servo_bus_port" value="$(arg servo_bus_port)"/>
  <xacro:arg name="servo_bus_baud" default="1000000"/>
  <xacro:property name="servo_bus_baud" value="$(arg servo_bus_baud)"/>
  <xacro:arg name="servo_id" default="1"/>
  <xacro:property name="servo_id" value="$(arg servo_id)"/>
  <!-- BENCH CALIBRATION for gripper_type:=st3215, and the only two numbers in
       the whole gripper that cannot be derived from the CAD.

       gripper_closed_steps  the servo's raw encoder step at q = +0.07 rad,
                             jaws touching. Depends on how the pinion was
                             clocked onto the horn at assembly, so it changes
                             whenever the servo is unbolted.
       gripper_servo_invert  whether a rising step count closes or opens.

       They are launch args rather than devices.yaml entries because they are
       calibration, not device identity - devices.yaml says so in its header.
       See st3215_gripper_hardware's package header for how to measure them. -->
  <xacro:arg name="gripper_closed_steps" default="3307"/>
  <xacro:property name="gripper_closed_steps" value="$(arg gripper_closed_steps)"/>
  <xacro:arg name="gripper_servo_invert" default="false"/>
  <xacro:property name="gripper_servo_invert" value="$(arg gripper_servo_invert)"/>
  <!-- Derived from the measured stops by aries_common.gripper_cal and passed in
       by the launch files; the defaults here only serve a bare xacro run. -->
  <xacro:arg name="gripper_command_open" default="-4.18"/>
  <xacro:property name="gripper_command_open" value="$(arg gripper_command_open)"/>
  <xacro:include filename="common_properties.xacro"/>
  <xacro:include filename="aries_gazebo.xacro"/>
  <xacro:include filename="aries_base.xacro"/>
  <xacro:include filename="drill.xacro"/>
  <xacro:include filename="stacklight.xacro"/>
  <xacro:include filename="rear_camera.xacro"/>
  <xacro:include filename="differential_link.xacro"/>
  <xacro:include filename="left_link.xacro"/>
  <xacro:include filename="right_link.xacro"/>
  <xacro:include filename="d435i.xacro"/>
  <!-- <xacro:include filename="arm.xacro" /> -->
  <xacro:include filename="igus_rebel_robot2.urdf.xacro"/>
  <xacro:include filename="igus_rebel2.control.xacro"/>
  <!-- Instantiate the arm control macro -->
  <xacro:igus_rebel_control arm_id="aries" hardware_protocol="${hardware_protocol}" arm_hardware_protocol="${arm_hardware_protocol}" gripper_hardware_protocol="${gripper_hardware_protocol}" serial_port="${serial_port}" gripper_type="${gripper_type}" servo_bus_port="${servo_bus_port}" servo_bus_baud="${servo_bus_baud}" servo_id="${servo_id}" gripper_closed_steps="${gripper_closed_steps}" gripper_servo_invert="${gripper_servo_invert}" gripper_command_open="${gripper_command_open}"/>
  <!-- A gripper_type this file does not build must fail loudly rather than
       leave the arm with no end effector, which reads in RViz as "the gripper
       meshes did not load" and sends you looking at mesh paths. -->
  <xacro:if value="${gripper_type != 'st3215'}">
    <xacro:gripper_type_must_be_st3215/>
  </xacro:if>
  <xacro:include filename="gripper_st3215.xacro"/>
</robot>
