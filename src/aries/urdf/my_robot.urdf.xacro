<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aries">
  <!-- The REBEL-6DOF-04 gripper (meshing sector gears) is the only gripper
       this robot is built with. The 85.563 mm four-bar ('new') and the
       original ('old') are retired to urdf/legacy/ and are not reachable from
       here; nothing in the fleet runs them any more.

       The argument is still declared because a dozen launch files pass
       gripper_type:=v2 down to this file, and an undeclared arg is a hard
       error. It is accepted and ignored - there is no branch left to take. -->
  <xacro:arg name="gripper_type" default="v2"/>
  <!-- Swappable fingertip - 'bucket', 'maintenance', or 'probe' -->
  <xacro:arg name="finger_type" default="probe"/>
  <xacro:property name="finger_type" value="$(arg finger_type)"/>
  <!-- Hardware protocol - 'mock_hardware', 'gazebo', or 'rebel' -->
  <xacro:arg name="hardware_protocol" default="gazebo"/>
  <xacro:property name="hardware_protocol" value="$(arg hardware_protocol)"/>
  <!-- Allow arm and gripper hardware backends to diverge for special launch cases -->
  <xacro:arg name="arm_hardware_protocol" default="$(arg hardware_protocol)"/>
  <xacro:property name="arm_hardware_protocol" value="$(arg arm_hardware_protocol)"/>
  <xacro:arg name="gripper_hardware_protocol" default="$(arg hardware_protocol)"/>
  <xacro:property name="gripper_hardware_protocol" value="$(arg gripper_hardware_protocol)"/>
  <!-- Teensy gripper serial port (only used when hardware_protocol=rebel) -->
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:property name="serial_port" value="$(arg serial_port)"/>
  <xacro:include filename="common_properties.xacro"/>
  <xacro:include filename="aries_gazebo.xacro"/>
  <xacro:include filename="aries_base.xacro"/>
  <xacro:include filename="drill.xacro"/>
  <xacro:include filename="stacklight.xacro"/>
  <xacro:include filename="differential_link.xacro"/>
  <xacro:include filename="left_link.xacro"/>
  <xacro:include filename="right_link.xacro"/>
  <xacro:include filename="d435i.xacro"/>
  <!-- <xacro:include filename="arm.xacro" /> -->
  <xacro:include filename="igus_rebel_robot2.urdf.xacro"/>
  <xacro:include filename="igus_rebel2.control.xacro"/>
  <!-- Instantiate the arm control macro -->
  <xacro:igus_rebel_control arm_id="aries" hardware_protocol="${hardware_protocol}" arm_hardware_protocol="${arm_hardware_protocol}" gripper_hardware_protocol="${gripper_hardware_protocol}" serial_port="${serial_port}"/>
  <xacro:include filename="gripper_v2.xacro"/>
</robot>
