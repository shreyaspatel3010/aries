<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:if value="${enable_lidar}">
        <xacro:property name="lidar_mount_xyz" value="0.2 -0.105 0.2202"/>

        <xacro:property name="sensor_height_offset" value="0.0628"/>

        <link name="Lidar_Link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.28"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh_location}/picoscan_150.stl"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh_location}/picoscan_150.stl"/>
                </geometry>
            </collision>
        </link>

        <joint name="Lidar_Joint" type="fixed">
            <origin xyz="${lidar_mount_xyz}" rpy="0 0 0"/>
            <parent link="base_link"/>
            <child link="Lidar_Link"/>
        </joint>

        <link name="Lidar_Scan_Link"/>

        <joint name="Lidar_Scan_Joint" type="fixed">
            <origin xyz="0 0 ${sensor_height_offset}" rpy="0 0 0"/>
            <parent link="Lidar_Link"/>
            <child link="Lidar_Scan_Link"/>
        </joint>

        <gazebo reference="Lidar_Scan_Link">
            <sensor name="gpu_lidar_points" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <topic>/lidar</topic>
                <update_rate>60</update_rate>
                <ray>
                    <scan>
                    <horizontal>
                        <samples>1024</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle> 3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1025</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle> 3.14159</max_angle>
                    </vertical>
                    </scan>
                    <range>
                    <min>0.05</min>
                    <max>45.0</max>
                    <resolution>0.01</resolution>
                    </range>
                </ray>
                <gz_frame_id>Lidar_Scan_Link</gz_frame_id>
                <always_on>1</always_on>
                <visualize>true</visualize>
                </sensor>
            </gazebo>

            <!-- Dedicated planar sensor for ROS LaserScan output. -->
            <gazebo reference="Lidar_Scan_Link">
                <sensor name="gpu_lidar_scan" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <topic>/lidar_scan</topic>
                <update_rate>60</update_rate>
                <ray>
                    <scan>
                    <horizontal>
                        <samples>1024</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle> 3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </vertical>
                    </scan>
                    <range>
                    <min>0.05</min>
                    <max>45.0</max>
                    <resolution>0.01</resolution>
                    </range>
                </ray>
                <gz_frame_id>Lidar_Scan_Link</gz_frame_id>
                <always_on>1</always_on>
                <visualize>false</visualize>
                </sensor>
            </gazebo>
    </xacro:if>

</robot>
