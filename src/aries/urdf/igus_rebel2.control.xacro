<?xml version="1.0"?>
<!-- igus_rebel.control.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="igus_rebel_control" params="arm_id hardware_protocol arm_hardware_protocol:='' gripper_hardware_protocol:='' serial_port:='/dev/ttyACM0' gripper_type:='v2' servo_bus_port:='/dev/aries_servo_bus' servo_bus_baud:='1000000' servo_id:='1' gripper_closed_steps:='3000' gripper_servo_invert:='false'">
        <xacro:macro name="joint_control" params="joint">
            <joint name="${joint}">
                <xacro:if value="${arm_hardware_protocol == 'mock_hardware' or (arm_hardware_protocol == '' and hardware_protocol == 'mock_hardware')}">
                    <command_interface name="position" />
                </xacro:if>
                <xacro:if value="${arm_hardware_protocol == 'gazebo' or (arm_hardware_protocol == '' and hardware_protocol == 'gazebo')}">
                    <command_interface name="position" />
                </xacro:if>
                <xacro:if value="${arm_hardware_protocol == 'rebel' or (arm_hardware_protocol == '' and hardware_protocol == 'rebel')}">
                    <command_interface name="velocity" />
                </xacro:if>
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>

        <ros2_control name="${arm_id}_controller" type="system">
            <hardware>
                <xacro:if value="${arm_hardware_protocol == 'mock_hardware' or (arm_hardware_protocol == '' and hardware_protocol == 'mock_hardware')}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${arm_hardware_protocol == 'gazebo' or (arm_hardware_protocol == '' and hardware_protocol == 'gazebo')}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                    <!-- position_proportional_gain does NOT belong here.
                         gz_ros2_control ignores <param> tags in <hardware> for
                         this setting and declares it as a ROS parameter on its
                         own gz_ros_control node, so the 5.0 that used to sit
                         here never applied — the package default of 0.1 ran
                         instead and the arm tracked joystick teleop at an
                         eighth of the commanded joint velocity. Verify with
                           ros2 param get /gz_ros_control position_proportional_gain
                         It is now set, with the derivation and the stability
                         ceiling, in aries_moveit/config/ros2_controllers.yaml,
                         which this plugin block already loads below. -->
                </xacro:if>
                <xacro:if value="${arm_hardware_protocol == 'rebel' or (arm_hardware_protocol == '' and hardware_protocol == 'rebel')}">
                    <plugin>Igus/Rebel</plugin>
                </xacro:if>
            </hardware>
            <xacro:joint_control joint="joint1" />
            <xacro:joint_control joint="joint2" />
            <xacro:joint_control joint="joint3" />
            <xacro:joint_control joint="joint4" />
            <xacro:joint_control joint="joint5" />
            <xacro:joint_control joint="joint6" />

            <xacro:if value="${arm_hardware_protocol == 'gazebo' or (arm_hardware_protocol == '' and hardware_protocol == 'gazebo')}">
                <joint name="gripper_gear_left_joint">
                    <command_interface name="position" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>
                <!-- The four-bar followers are READ ONLY here.
                     They used to carry mimic/multiplier params as well, which
                     coupled them a SECOND time: sdformat converts the URDF
                     <mimic> tags in gripper_new.xacro into real SDF <mimic>
                     constraints (confirmed with `gz sdf -p`), so DART already
                     enforces q_follower = q_leader inside the solver. Adding
                     the ros2_control mimic on top makes gz_ros2_control write
                     a velocity command to each of the same five joints every
                     cycle, so each DOF carries a hard kinematic constraint and
                     an independent servo command that know nothing about each
                     other, both with the joints' 500 N.m effort ceiling behind
                     them. Two solvers arguing over one DOF is what tears a
                     linkage apart on screen while every joint is individually
                     "satisfied".
                     Keep the constraint (it is solved with the dynamics and
                     cannot drift) and drop the commands. The state interfaces
                     stay so the followers still report their measured
                     positions. -->
                <xacro:if value="${gripper_type == 'v2'}">
                    <joint name="gripper_gear_right_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                    <joint name="gripper_link_left_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                    <joint name="gripper_link_right_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                    <joint name="gripper_bucket_left_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                    <joint name="gripper_bucket_right_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                </xacro:if>
                <!-- The ST3215 gripper has two followers, not five, and they
                     are PRISMATIC: their state is metres, not radians. Its
                     fingertips are bolted to the racks with fixed joints, so
                     there is nothing else to report. -->
                <xacro:if value="${gripper_type == 'st3215'}">
                    <joint name="gripper_rack_left_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                    <joint name="gripper_rack_right_joint">
                        <state_interface name="position" />
                        <state_interface name="velocity" />
                    </joint>
                </xacro:if>
            </xacro:if>
        </ros2_control>

        <xacro:if value="${gripper_hardware_protocol == 'mock_hardware' or (gripper_hardware_protocol == '' and hardware_protocol == 'mock_hardware')}">
            <ros2_control name="${arm_id}_gripper_mock" type="system">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                </hardware>

                <!-- The command range is the FITTED gripper's, not a shared
                     constant: v2 stops at -1.57 and the ST3215 runs to -4.065.
                     Clamping the ST3215 at -1.57 would quietly cap mock runs
                     at a 32.9 mm jaw gap against the real 82.9. -->
                <xacro:property name="gripper_mock_min"
                                value="${-4.065 if gripper_type == 'st3215' else -1.57}"/>
                <joint name="gripper_gear_left_joint">
                    <command_interface name="position">
                        <param name="min">${gripper_mock_min}</param>
                        <param name="max">0.07</param>
                    </command_interface>
                    <state_interface name="position">
                        <param name="initial_value">${gripper_mock_min}</param>
                    </state_interface>
                    <state_interface name="velocity" />
                </joint>
            </ros2_control>
        </xacro:if>

        <xacro:if value="${gripper_hardware_protocol == 'rebel' or (gripper_hardware_protocol == '' and hardware_protocol == 'rebel')}">
            <ros2_control name="${arm_id}_gripper" type="system">
                <hardware>
                    <plugin>teensy_gripper_hardware/TeensyGripperSystem</plugin>
                    <param name="cmd_topic">/gripper/cmd</param>
                    <param name="state_topic">/gripper/state</param>
                    <param name="min_pos">-1.57</param>
                    <param name="max_pos">0.07</param>
                </hardware>

                <joint name="gripper_gear_left_joint">
                    <command_interface name="position" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                </joint>
            </ros2_control>
        </xacro:if>

        <!-- The ST3215 gripper does NOT go through the Teensy. Its servo hangs
             off the rover PC's own USB bus-servo adapter, so this component
             opens the serial port itself and speaks Feetech STS to it. That is
             also why it is a separate protocol value rather than another
             gripper_type branch inside 'rebel': the two grippers reach their
             servos over different wires, and 'rebel' means "through the
             Teensy". -->
        <xacro:if value="${gripper_hardware_protocol == 'st3215'}">
            <ros2_control name="${arm_id}_gripper" type="system">
                <hardware>
                    <plugin>st3215_gripper_hardware/ST3215GripperSystem</plugin>
                    <param name="port">${servo_bus_port}</param>
                    <param name="baud">${servo_bus_baud}</param>
                    <param name="servo_id">${servo_id}</param>
                    <!-- Servo step at the CLOSED end of travel (q = +0.07), and
                         the direction a rising step count moves the joint.
                         The only two numbers here that are NOT derived from the
                         CAD: they depend on how the pinion was clocked onto the
                         horn at assembly, so they change whenever the servo is
                         unbolted. Passed in as launch args - see the package
                         header for how to measure them. -->
                    <param name="closed_steps">${gripper_closed_steps}</param>
                    <param name="invert">${gripper_servo_invert}</param>
                    <param name="min_pos">-4.065</param>
                    <param name="max_pos">0.07</param>
                    <!-- 0 leaves the servo's stored acceleration alone. Do not
                         set this casually: on this servo the acceleration
                         register silently caps top speed AND is what produced
                         a 44 deg overshoot on the bench. -->
                    <param name="accel">0</param>
                    <param name="goal_speed">2000</param>
                    <param name="torque_limit">800</param>
                </hardware>

                <joint name="gripper_gear_left_joint">
                    <command_interface name="position" />
                    <state_interface name="position" />
                    <state_interface name="velocity" />
                    <!-- Real feedback, unlike the Teensy gripper: the ST3215
                         reports present position, speed and load, so effort
                         here is a measurement and not an echo. -->
                    <state_interface name="effort" />
                </joint>
            </ros2_control>
        </xacro:if>

        <xacro:if value="${arm_hardware_protocol == 'gazebo' or (arm_hardware_protocol == '' and hardware_protocol == 'gazebo')}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>$(find aries_moveit)/config/ros2_controllers.yaml</parameters>
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <controller_manager_name>controller_manager</controller_manager_name>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>