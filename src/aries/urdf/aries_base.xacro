<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

   
    <!-- Wheel Macro -->
    <xacro:macro name="wheel" params="prefix reflect">
        <link name="${prefix}_Wheel_Link">
            <inertial>
                <origin xyz="0 0 0.0350608778434713" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia
                    ixx="0.00914288966451803"
                    ixy="0"
                    ixz="0"
                    iyy="0.00914288966451803"
                    iyz="0"
                    izz="0.0160987749043434"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh_location}/${prefix}_Wheel_Link.STL"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh_location}/${prefix}_Wheel_Link.STL"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>


    <!-- IMU Frame -->
    <link name="imu_frame"/>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_frame"/>
        <!-- On the top deck, behind the front D435i. The deck plate in
             base.stl is the large up-facing surface at z = 0.212, so
             0.222 puts the sensor body 10 mm above it; the camera mount post
             occupies x ~ 0.24, and the camera itself sits at x = 0.2756
             (d435i.xacro), so x = 0.18 clears both on open deck. Was
             0 0 0.08, which was buried mid-chassis.

             Yaw is pi because the 3DM-GX5-AHRS is bolted into its cradle with
             the printed X arrow (and the connector it points at) facing the
             rover's REAR, so device X = -base_link X and device Y = -base_link Y.

             Roll stays 0 even though the printed triad shows Z into the
             mounting plate: microstrain.yaml sets use_enu_frame: true, so the
             driver has already rolled the native NED device frame 180 deg into
             ENU before publishing. This link describes the frame the driver
             publishes in (X fwd, Y left, Z up), not the silkscreen; adding that
             flip here would apply it twice and invert roll and yaw sign. -->
        <origin xyz="0.19 0.06 0.222" rpy="0.0 0.0 ${pi}"/>
    </joint>

    <!-- Base Footprint - root link for mobile robot (odom frame provided by odometry, not URDF) -->
    <link name="base_footprint">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <!-- See base_link_height in common_properties.xacro. Was 0.165, which
             sat 41 mm below the real wheel contact plane. -->
        <origin xyz="0 0 ${base_link_height}" rpy="0 0 0" />
    </joint>

    <!-- Base Link -->
    <link name="base_link">
        <inertial>
            <origin xyz="-0.0194894545849965 0.000308596526751935 0.119828029892907"
                    rpy="0 0 0" />
            <!-- The complete competition rover weighs 90 kg. The other links
                 total 49.0157953866879 kg with the default bucket fingertip,
                 so batteries, electronics and the
                 remaining chassis hardware are represented here. The inertia
                 tensor is scaled with mass from the original CAD tensor,
                 preserving the chassis radii of gyration.

                 2026-08-20: drill.xacro gained three links with real
                 inertials - the feed carriage (1.9407), the auger (2.1539)
                 and the sample container (0.2086), 4.3032 kg in total. That
                 mass was always inside this aggregate (drill_link carries no
                 inertial), so it is subtracted here rather than added to the
                 rover. The same day the bucket fingertip was re-integrated
                 from its new mesh and lost 1.6 g a side, 3.2 g over the pair,
                 which comes back the other way. So the other links now total
                 53.3157953866879 and this is 90 - that = 36.6842046133121,
                 with the tensor scaled by the same 0.895082 ratio the note
                 above describes. The 90 kg total is unchanged.

                 2026-08-22: stacklight.xacro added a 0.15 kg link on the rear
                 deck, taken out of here the same way, so the other links total
                 53.4657953866879 and this was 90 - that = 36.5342046133121.
                 The tensor is NOT rescaled for it: 0.15 kg is 0.4% of this
                 mass, comfortably inside the accuracy of an aggregate whose
                 COM is already stated above as an approximation, and rescaling
                 would dress that up as precision it does not have.

                 2026-08-22: rear_camera.xacro added a 0.075 kg link under the
                 rear belly plate, taken out the same way again, so the other
                 links total 53.5407953866879 and this is 90 - that =
                 36.4592046133121. Not rescaled either, and for the same
                 reason - it is 0.2% of this mass, half of what the stack light
                 already went unrescaled for.

                 The COM below is NOT moved, and it is now an approximation in
                 a way it was not before: it is the aggregate COM of a set that
                 included the drill, and the drill sits ~0.48 m behind it. The
                 honest correction needs the chassis CAD breakdown, which is
                 not in this repo; shifting it on a guess would be worse than
                 leaving it stated. Net effect of the change is that 4.3 kg
                 moved from x = -0.019 back to where the drill actually is,
                 which is the right direction. -->
            <mass value="36.4592046133121" />
            <inertia
                ixx="0.507621773860222"
                ixy="-0.000188272929114966"
                ixz="0.0490933123721815"
                iyy="1.07676402193725"
                iyz="5.65440825182202E-11"
                izz="1.38952745581972" />
        </inertial>
        <visual>
            <origin xyz="0 0 0"
                    rpy="0 0 0" />
            <geometry>
                <mesh filename="${mesh_location}/base.glb" />
            </geometry>
            
        </visual>
        <collision>
            <origin xyz="0 0 0"
                    rpy="0 0 0" />
            <geometry>
                <mesh filename="${mesh_location}/base.stl" />
            </geometry>
        </collision>
    </link>

    

    


    
    
  
    

    
</robot>
