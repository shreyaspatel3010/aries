      <geometry><box><size>0.050 0.050 0.002</size></box></geometry>
      <material>
        <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
        <pbr><metal>
          <albedo_map>model://maintenance_panel/aruco_orig_11.png</albedo_map>
          <roughness>0.9</roughness><metalness>0</metalness>
        </metal></pbr>
      </material>
    </visual>
