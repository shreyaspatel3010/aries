<launch>
  <arg name="gripper_type" default="v2"/>
  <arg name="finger_type" default="bucket"/>
  <include file="$(find-pkg-share aries)/launch/display.launch.xml">
    <arg name="gripper_type" value="$(var gripper_type)"/>
    <arg name="finger_type" value="$(var finger_type)"/>
  </include>
</launch>
