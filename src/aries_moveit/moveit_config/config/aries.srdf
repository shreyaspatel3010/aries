    <disable_collisions link1="L_Boggie_Link" link2="R_Boggie_Link" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="R_Connecting_Rod_Diff_Link" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="R_Rocker_Link" reason="Adjacent"/>
