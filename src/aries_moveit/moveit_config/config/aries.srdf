    <disable_collisions link1="L_2_Wheel_Link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="L_3_Wheel_Link" link2="L_Boggie_Link" reason="Adjacent"/>
