    <disable_collisions link1="L_2_Wheel_Link" link2="R_Connecting_Rod_Diff_Link" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="R_Rocker_Link" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="arm_base_link" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="L_2_Wheel_Link" link2="rover_camera_link" reason="Adjacent"/>
