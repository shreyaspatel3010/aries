    <disable_collisions link1="R_Boggie_Link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="R_Boggie_Link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="R_Boggie_Link" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="R_Rocker_Link" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="arm_base_link" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="rover_camera_link" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="R_Connecting_Rod_Diff_Link" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="arm_base_link" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="rover_camera_link" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="R_Rocker_Link" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="rover_camera_link" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_gear_left_link" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="gripper_bucket_left_link" link2="gripper_bucket_right_link" reason="Never"/>
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_bucket_left_link" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_bucket_right_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_gear_left_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="gripper_gear_left_link" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rover_camera_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="drill_link" reason="Adjacent"/>
    <!-- The drill's two prismatic links (2026-08-20). Each is Adjacent to the
         mast it rides and never reaches the chassis, whose bbox stops at
         x = -0.36 while the carriage lives at x = -0.61..-0.44.
         drill_motor_link vs drill_container_link is deliberately absent: the
         bin runs under the auger, so feeding down onto it is a REAL collision
         and must stay checked. drill_bit_link has no collision geometry at
         all and so needs no entry. -->
    <disable_collisions link1="drill_link" link2="drill_motor_link" reason="Adjacent"/>
    <disable_collisions link1="drill_link" link2="drill_container_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="drill_motor_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="drill_container_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="rover_camera_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="rover_camera_link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="rover_camera_link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="rover_camera_link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="rover_camera_link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="motor5" reason="Adjacent"/>
    <!-- link2 collides with nothing at the shoulder. Its collision geometry is
         a single r=60 mm x 180 mm cylinder standing in for an offset, L-shaped
         link, so it fills the concave volume that motor1 and motor4 swing
         through and reports contact below joint2/joint3 = -77.2 deg. Swept over
         the full joint range against the CAD geometry the true clearance never
         drops below 19.7 mm (motor1) / 21.1 mm (motor4), so these are Never
         pairs. Refitting the link2 cylinder would make them unnecessary. -->
    <disable_collisions link1="link2" link2="motor1" reason="Never"/>
    <disable_collisions link1="link2" link2="motor4" reason="Never"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="motor1" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="motor1" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="motor2" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="motor2" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="motor2" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="motor3" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="motor3" link2="motor5" reason="Adjacent"/>
    <disable_collisions link1="motor4" link2="motor5" reason="Adjacent"/>
    <!-- Gripper camera (rigidly mounted on arm_gripper_base_link) -->
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_camera_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_gear_left_link" link2="gripper_camera_link" reason="Never"/>
    <!-- Four-bar linkage: bucket links overlap gear/link bodies in all configurations -->
    <disable_collisions link1="gripper_bucket_left_link" link2="gripper_gear_left_link" reason="Never"/>
    <!-- Closed gripper: the jaws intentionally approach each other -->
    <disable_collisions link1="gripper_gear_left_link" link2="gripper_bucket_right_link" reason="Never"/>

    <!-- ==================================================================
         THE GRIPPER (gripper_type:=st3215, the only one)

         This file is XACRO, not `cat`, because the `open` group state has to
         carry the calibrated open angle from
         aries_common/config/gripper_st3215.yaml. Every launch path that loads
         it MUST pass gripper_command_open.

         It used to hold the union of two grippers' links, which cost twelve red
         lines at every startup: srdfdom does NOT skip an unknown link in a
         GROUP, it logs it as an Error, once per node, and four nodes load the
         model. With v2 retired there is only one link set and no warnings.

         The group link list is not cosmetic: rebel_servo_teleop_gamepad sets
         req.group_name to `arm_with_gripper` and calls checkSelfCollision, so a
         link missing from the group is a link the joystick guard does not
         check. -->
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_rack_left_link" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_base_link" link2="gripper_rack_right_link" reason="Adjacent"/>
    <!-- The two racks share one volume around the pinion: their carrier blocks
         both span the full 77.5 mm depth over x = -5 to +10 mm and interleave
         there. They are one degree of freedom and cannot be driven into each
         other, so this pair is meaningless to check and never passes. -->
    <disable_collisions link1="gripper_rack_left_link" link2="gripper_rack_right_link" reason="Never"/>
    <!-- Each rack is IN MESH with the pinion by design. -->
    <disable_collisions link1="gripper_rack_left_link" link2="gripper_gear_left_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_rack_right_link" link2="gripper_gear_left_link" reason="Adjacent"/>
    <!-- Fingertips are bolted to their own rack, and each rack's tail runs
         under the OPPOSITE jaw. -->
    <disable_collisions link1="gripper_rack_left_link" link2="gripper_bucket_left_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_rack_right_link" link2="gripper_bucket_right_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_rack_left_link" link2="gripper_bucket_right_link" reason="Never"/>
    <disable_collisions link1="gripper_rack_right_link" link2="gripper_bucket_left_link" reason="Never"/>
    <disable_collisions link1="gripper_rack_left_link" link2="gripper_camera_link" reason="Never"/>
    <disable_collisions link1="gripper_rack_right_link" link2="gripper_camera_link" reason="Never"/>
</robot>
