    <disable_collisions link1="gripper_right_link" link2="gripper_bucket_left_link" reason="Never"/>
    <!-- Tip connectors (massless fixed sub-links) -->
    <disable_collisions link1="gripper_gear_left_link" link2="gripper_gear_tip_left_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_gear_right_link" link2="gripper_gear_tip_right_link" reason="Adjacent"/>
