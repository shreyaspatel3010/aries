    <disable_collisions link1="L_Boggie_Link" link2="rover_camera_link" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="motor1" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="motor2" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="motor3" reason="Adjacent"/>
    <disable_collisions link1="L_Boggie_Link" link2="motor4" reason="Adjacent"/>
    <disable_collisions link1="L_Connecting_Rod_Diff_Link" link2="L_Rocker_Link" reason="Adjacent"/>
    
    <disable_collisions link1="L_Connecting_Rod_Diff_Link" link2="R_3_Wheel_Link" reason="Adjacent"/>
