<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aries_load_cells</name>
  <version>0.1.0</version>
  <description>
    The rover's three load cells, published as weights in kilograms: the sand
    and stone boxes on the left of the deck, and the drill's sample bin. The
    cells hang off the gripper Teensy and arrive over the micro-ROS link
    aries_bringup already starts, so this package holds only the node that
    turns raw converter counts into kilograms, and the calibration it does it
    with.
  </description>

  <maintainer email="shreyaspatel517@gmail.com">shreyas</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- The shipped config is checked against the bin's stroke in drill.xacro. -->
  <test_depend>aries</test_depend>
  <test_depend>python3-yaml</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- Trigger, for the tare services. -->
  <exec_depend>std_srvs</exec_depend>
  <!-- JointState, for the optional measured bin position. -->
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
